{
  "name": "dsh-top-leaderboard",
  "version": "0.1.0",
  "description": "DSH Web 插件热度榜单：侧栏「榜单」按钮 + 弹窗排行 + 一键安装（复用官方 Profile/Bundle 契约）",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "plugin",
    "leaderboard"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l541402398/dsh-top-leaderboard.git"
  },
  "exports": {
    ".": {
      "default": "./dist/index.mjs"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "data/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
